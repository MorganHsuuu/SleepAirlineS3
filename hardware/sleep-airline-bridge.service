[Unit]
Description=Sleep Airline reed magnets and heading knob
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=__USER__
Group=__USER__
SupplementaryGroups=gpio i2c
WorkingDirectory=__DEST__
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 __DEST__/device_bridge.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
