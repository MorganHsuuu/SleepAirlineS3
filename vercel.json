{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "redirects": [
    { "source": "/classic", "destination": "/classic/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/review", "destination": "/review.html" },
    { "source": "/review/", "destination": "/review.html" },
    { "source": "/api/(.*)", "destination": "/api" }
  ],
  "crons": [
    { "path": "/api/reminders/cron", "schedule": "0 12 * * *" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 120
    }
  }
}
